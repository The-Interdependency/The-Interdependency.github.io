{% set claims = research_data.claims | where("article", researchArticleId) %}
<section>
  <p class="eyebrow">Reviewed research attachment</p>
  <h2>Support, dissent, and limits</h2>
  <p class="section-intro">These records attach sources to bounded claims. They support, challenge, or limit the public reading without converting interpretation into canon.</p>
  {% if claims.length %}
    <div class="grid">
      {% for claim in claims %}
        {% set stanceClass = "status-research" %}
        {% if claim.stance == "dissent" %}{% set stanceClass = "status-risk" %}{% endif %}
        {% if claim.stance == "limit" or claim.stance == "mixed" %}{% set stanceClass = "status-frontier" %}{% endif %}
        <article class="card">
          <span class="status {{ stanceClass }}">{{ claim.stance }} · {{ claim.status }}</span>
          <h3>{{ claim.claim }}</h3>
          <p><strong>Evidence boundary:</strong> {{ claim.limitation }}</p>
          <div class="source-list"><strong>Sources:</strong><ul>
            {% for sourceId in claim.source_ids %}
              {% for source in research_data.sources %}
                {% if source.id == sourceId %}<li><a href="{{ source.url }}">{{ source.title }}</a><br><small>{{ source.type }} · reviewed {{ source.reviewed_on }}</small><br><small>{{ source.boundary }}</small></li>{% endif %}
              {% endfor %}
            {% endfor %}
          </ul></div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="hmmm"><p>No reviewed claim is attached to this article yet.</p></div>
  {% endif %}
</section>
